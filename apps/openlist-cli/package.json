{
  "name": "@tnnevol/openlist-cli",
  "version": "1.0.0",
  "description": "CLI for OpenList - A modern file list program",
  "type": "module",
  "bin": {
    "openlist-cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run src/__tests__/e2e.test.ts"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "undici": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^17.4.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "openlist",
    "alist",
    "cli",
    "file-manager"
  ],
  "author": "tnnevol",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
