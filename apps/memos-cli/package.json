{
  "name": "@tnnevol/memos-cli",
  "type": "module",
  "version": "1.0.0",
  "description": "CLI for Memos - A self-hosted timeline-based note service",
  "author": "tnnevol",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/tnnevol/skills",
  "bugs": {
