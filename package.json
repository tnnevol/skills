{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "eslint .",
    "chandao:build": "pnpm --filter @tnnevol/chandao-cli build",
    "chandao:build:linux": "pnpm --filter @tnnevol/chandao-cli build:linux",
    "chandao:build:macos": "pnpm --filter @tnnevol/chandao-cli build:macos",
    "chandao:build:windows": "pnpm --filter @tnnevol/chandao-cli build:windows",
    "chandao:clean": "pnpm --filter @tnnevol/chandao-cli clean",
    "chandao:verify": "pnpm --filter @tnnevol/chandao-cli verify",
    "chandao:publish": "pnpm --filter @tnnevol/chandao-cli publish",
    "chandao:bump": "bumpp",
    "chandao:bump:patch": "bumpp patch -y",
    "chandao:bump:minor": "bumpp minor -y",
    "chandao:bump:major": "bumpp major -y"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@clack/prompts": "^1.1.0",
    "@types/node": "^25.5.0",
    "bumpp": "^11.0.1",
    "eslint": "^10.0.3",
    "lint-staged": "^16.3.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts}": "eslint --fix"
  }
}